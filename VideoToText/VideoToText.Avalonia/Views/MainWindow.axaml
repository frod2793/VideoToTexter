<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:VideoToText.Avalonia.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="700" d:DesignHeight="600"
        x:Class="VideoToText.Avalonia.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="비디오 텍스터 - Whisper Converter"
        Background="#1E1E1E"
        TransparencyLevelHint="AcrylicBlur"
        ExtendClientAreaToDecorationsHint="True">

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <Panel>
        <ExperimentalAcrylicBorder IsHitTestVisible="False">
            <ExperimentalAcrylicBorder.Material>
                <ExperimentalAcrylicMaterial
                    BackgroundSource="Digger"
                    TintColor="Black"
                    TintOpacity="0.8"
                    MaterialOpacity="0.6" />
            </ExperimentalAcrylicBorder.Material>
        </ExperimentalAcrylicBorder>

        <Grid RowDefinitions="Auto, *, Auto" Margin="30">
            <StackPanel Grid.Row="0" Margin="0,0,0,20">
                <TextBlock Text="비디오 텍스터" 
                           FontSize="24" FontWeight="Bold" 
                           Foreground="{StaticResource SystemAccentBrush}"
                           LetterSpacing="2"/>
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <TextBlock Text="Powered by Whisper.net" 
                               FontSize="12" Opacity="0.5" />
                    <TextBlock Text=" | " FontSize="12" Opacity="0.3"/>
                    <TextBlock Text="made by woodenshield" 
                               FontSize="12" Opacity="0.8" 
                               Foreground="{StaticResource SystemAccentBrush}"/>
                </StackPanel>
            </StackPanel>

            <Grid Grid.Row="1" RowDefinitions="Auto, Auto, Auto, *, Auto" ColumnDefinitions="*, Auto">
                
                <StackPanel Grid.Row="0" Grid.ColumnSpan="2" Margin="0,0,0,10">
                    <TextBlock Text="영상 파일 소스" FontSize="10" FontWeight="Bold" Margin="0,0,0,5" Opacity="0.7"/>
                    <Grid ColumnDefinitions="*, Auto">
                        <TextBox Text="{Binding VideoPath}" 
                                 Watermark="변환할 영상을 선택하세요..." 
                                 Padding="10" 
                                 Background="#2D2D2D" BorderThickness="0"/>
                        <Button Grid.Column="1" Content="찾기" 
                                Click="OnBrowseClick"
                                Margin="10,0,0,0" 
                                Background="{StaticResource SystemAccentBrush}" 
                                Foreground="Black" FontWeight="Bold"/>
                    </Grid>
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Margin="0,10,0,10">
                    <TextBlock Text="출력 위치 설정" FontSize="10" FontWeight="Bold" Margin="0,0,0,5" Opacity="0.7"/>
                    <Grid ColumnDefinitions="*, Auto">
                        <TextBox Text="{Binding OutputPath}" 
                                 Watermark="자막 저장 폴더를 선택하세요 (기본: 영상과 동일)..." 
                                 Padding="10" 
                                 Background="#2D2D2D" BorderThickness="0"/>
                        <Button Grid.Column="1" Content="변경" 
                                Click="OnBrowseOutputClick"
                                Margin="10,0,0,0" 
                                Background="{StaticResource SystemAccentBrush}" 
                                Foreground="Black" FontWeight="Bold"/>
                    </Grid>
                </StackPanel>

                <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Margin="0,10,0,20">
                    <TextBlock Text="변환 인공지능 모델" FontSize="10" FontWeight="Bold" Margin="0,0,0,5" Opacity="0.7"/>
                    <Grid ColumnDefinitions="*, Auto">
                        <ComboBox ItemsSource="{Binding AvailableModels}" 
                                   SelectedItem="{Binding SelectedModel}"
                                   HorizontalAlignment="Stretch"
                                   Background="#2D2D2D" BorderThickness="0" Padding="10"/>
                        <Button Grid.Column="1" Content="모델 다운로드"
                                Command="{Binding DownloadModelCommand}"
                                IsEnabled="{Binding !IsProcessing}"
                                Margin="10,0,0,0"
                                Padding="15,8"
                                Background="#444444" Foreground="White" FontSize="11" CornerRadius="4"/>
                    </Grid>
                </StackPanel>

                <Grid Grid.Row="3" Grid.ColumnSpan="2">
                    <Border Background="#151515" CornerRadius="8" Padding="1">
                        <ListBox ItemsSource="{Binding Logs}" 
                                 Background="Transparent" BorderThickness="0"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" FontSize="11" Foreground="#00FFD2" FontFamily="Consolas, monospace"/>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>
                    <Button HorizontalAlignment="Right" VerticalAlignment="Top"
                            Margin="10" Padding="8,4"
                            Content="로그 복사"
                            Command="{Binding CopyLogsCommand}"
                            Background="#333333" Foreground="White" 
                            FontSize="10" CornerRadius="4" Opacity="0.7"/>
                </Grid>

                <StackPanel Grid.Row="4" Grid.ColumnSpan="2" Margin="0,20,0,0">
                    <Grid ColumnDefinitions="*, Auto, Auto">
                        <TextBlock Text="변환 진행 상태" FontSize="10" FontWeight="Bold" Opacity="0.7"/>
                        <TextBlock Grid.Column="1" Text="{Binding EstimatedTimeRemaining}" 
                                   FontSize="10" Opacity="0.5" Margin="0,0,10,0" 
                                   HorizontalAlignment="Right" VerticalAlignment="Bottom"/>
                        <TextBlock Grid.Column="2" Text="{Binding Progress, StringFormat={}{0:F1}%}" FontSize="10" FontWeight="Bold"/>
                    </Grid>
                    <ProgressBar Height="4" Margin="0,5,0,0" 
                                 Minimum="0" Maximum="100" 
                                 Value="{Binding Progress}"
                                 Foreground="{StaticResource SystemAccentBrush}"
                                 Background="#333333"/>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="2" ColumnDefinitions="*, Auto" Margin="0,20,0,0">
                <TextBlock Text="{Binding Status}" VerticalAlignment="Center" FontSize="12" Opacity="0.6"/>
                <Button Grid.Column="1" 
                        Command="{Binding StartTranscriptionCommand}" 
                        IsEnabled="{Binding !IsProcessing}"
                        Content="변환 작업 시작" 
                        Padding="30,12" 
                        Background="{StaticResource SystemAccentBrush}" 
                        Foreground="Black" FontWeight="Bold" CornerRadius="4"/>
            </Grid>
        </Grid>
    </Panel>
</Window>
